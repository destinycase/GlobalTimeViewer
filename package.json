{
  "name": "globaltimeviewer",
  "version": "3.11.4",
  "description": "Global Time Viewer는 여러 시간대를 빠르게 비교하고, 시간 조정/기간 계산/복사/이미지 저장까지 처리할 수 있는 브라우저 기반 도구입니다.",
  "main": "main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "powershell -ExecutionPolicy Bypass -File build_extension.ps1",
    "build:strict": "powershell -ExecutionPolicy Bypass -File build_extension.ps1 -EnforceVersionConsistency",
    "build:vite": "vite build",
    "ci:gate": "npm run lint && npm run test:coverage && npm run build:strict"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "eslint": "^9.22.0",
    "@vitest/coverage-v8": "^3.2.4",
    "terser": "^5.46.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  }
}
